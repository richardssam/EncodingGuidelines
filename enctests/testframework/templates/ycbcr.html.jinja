<!DOCTYPE html>
{#- Report for the ycbcr comparison (ycbcr_compare.py). All errors are in 10-bit code values. -#}
{%- from "_macros.html.jinja" import status, num, doc_link -%}
{#- Mean signed error against the ideal level, one line per plane. The scale fits the largest error, at least +-2. -#}
{%- macro level_plot(r) -%}
  {%- set levels = r.error_by_level or {} -%}
  {%- set ns = namespace(top=2) -%}
  {%- for name, points in levels.items() -%}{%- for p in points -%}
    {%- if p[1] | abs > ns.top -%}{%- set ns.top = [p[1] | abs, 64] | min -%}{%- endif -%}
  {%- endfor -%}{%- endfor -%}
  {%- set top = ns.top | round(0, 'ceil') -%}
  {%- set w, h, pad = 380, 150, 28 -%}
  <svg class="plot" viewBox="0 0 {{ w }} {{ h }}" role="img" aria-label="Mean error against level">
    <rect x="{{ pad }}" y="4" width="{{ w - pad - 16 }}" height="{{ h - 24 }}" class="frame"/>
    {%- for v in [top, top / 2, 0, -top / 2, -top] %}
    {%- set y = 4 + (h - 24) * (top - v) / (2 * top) %}
    <line x1="{{ pad }}" x2="{{ w - 16 }}" y1="{{ y }}" y2="{{ y }}" class="{{ 'zero' if v == 0 else 'grid' }}"/>
    <text x="{{ pad - 4 }}" y="{{ y + 3 }}" text-anchor="end">{{ "%+g" | format(v) if v else "0" }}</text>
    {%- endfor %}
    {%- for v in [0, 256, 512, 768, 1023] %}
    {%- set x = pad + (w - pad - 16) * v / 1023 %}
    <text x="{{ x }}" y="{{ h - 8 }}" text-anchor="middle">{{ v }}</text>
    {%- endfor %}
    {%- for name, points in levels.items() if points %}
    <polyline class="line {{ name }}" points="
      {%- for p in points %}{{ '%.1f' | format(pad + (w - pad - 16) * p[0] / 1023) }},{{ '%.1f' | format(4 + (h - 24) * (top - ([[p[1], top] | min, -top] | max)) / (2 * top)) }} {% endfor %}"/>
    {%- endfor %}
  </svg>
{%- endmacro -%}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ config.title }}</title>
  <style>
{% include "_style.css.jinja" %}
    .card img.map { max-width: 100%; width: 900px; image-rendering: pixelated; border-radius: 4px; }
    .card img.thumb { width: 160px; margin-top: 6px; border-radius: 4px; }
    .legend { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); margin: 6px 0 12px; flex-wrap: wrap; }
    .ramp { width: 240px; height: 12px; border-radius: 2px;
            background: linear-gradient(to right, #1ae6ff, #0a3c66 40%, #03132e 47%, #000 50%, #2e1a01 53%, #66420a 60%, #ffff00); }
    .swatch { display: inline-block; width: 12px; height: 12px; border-radius: 2px; vertical-align: -2px; }
    .plot { width: 380px; max-width: 100%; }
    .plot text { fill: var(--muted); font-size: 9px; }
    .plot .frame { fill: none; stroke: var(--line); } .plot .grid { stroke: var(--line); stroke-dasharray: 2 3; }
    .plot .zero { stroke: var(--muted); } .plot .line { fill: none; stroke-width: 1.6; }
    .plot .y, .plot .g { stroke: var(--y); } .plot .cb, .plot .b { stroke: var(--cb); } .plot .cr, .plot .r { stroke: var(--cr); }
    a.open-viewer { cursor: zoom-in; }
    dialog.viewer { background: var(--bg); color: var(--fg); border: 1px solid var(--line); border-radius: 8px;
                    width: min(1600px, 96vw); max-height: 94vh; padding: 12px; }
    dialog.viewer::backdrop { background: rgba(0, 0, 0, .6); }
    .viewer .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 8px; }
    .viewer .bar h3 { margin: 0; flex: 1 1 auto; }
    .viewer .group { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
    .viewer .group button { background: var(--panel); color: var(--fg); border: 0; padding: 3px 10px; font: inherit; cursor: pointer; }
    .viewer .group button + button { border-left: 1px solid var(--line); }
    .viewer .group button[aria-pressed="true"] { background: var(--link); color: var(--bg); }
    .viewer .close { background: none; border: 0; color: var(--muted); font-size: 20px; cursor: pointer; }
    .viewer .scroller { overflow: auto; max-height: calc(94vh - 110px); }
    .viewer .stage { position: relative; user-select: none; touch-action: none; cursor: ew-resize; }
    .viewer .stage img { display: block; width: 100%; image-rendering: pixelated; pointer-events: none;
                         -webkit-user-drag: none; user-drag: none; }
    .viewer .stage img.over { position: absolute; inset: 0; height: 100%; }
    .viewer .divider { position: absolute; top: 0; bottom: 0; width: 2px; background: #fff; box-shadow: 0 0 0 1px #000; pointer-events: none; }
    .viewer .labels { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); margin-top: 4px; }
  </style>
</head>
<body>
  {%- set index_url = "../../../index.html" %}
  {% include "_nav.html.jinja" %}
  <h1>{{ config.title }}</h1>
  <p>{{ config.description }}</p>
  <p class="muted">FFmpeg {{ testinfo.ffmpeg_version }}
    {%- if testinfo.host_config %} on {{ testinfo.host_config.os }} {{ testinfo.host_config.os_version }} {{ testinfo.host_config.processor }}{% endif %}.
    Each encode is decoded at its own pixel format (no FFmpeg colour conversion) and compared with the ideal conversion
    of the source. Errors are in 10-bit code values (one 8-bit code value is 4), so different bit depths compare directly.</p>
  {%- set guide = "https://academysoftwarefoundation.github.io/EncodingGuidelines/enctests/ReadingColourReports.html" %}
  <p><a target="_blank" href="{{ guide }}">How to read this report</a>: the error maps, the grey areas and the level plots,
    with examples. Click an error map to compare it with the decoded frame.</p>
  <details>
    <summary>What the columns mean</summary>
    <dl class="key">
      <dt>Result</dt><dd>pass or fail against the config's asserts. <b>known</b>: a failure listed as a known issue for this
        FFmpeg version. <b>unexpected</b>: a known issue that passed, so it may have been fixed. <b>skipped</b>: this build
        cannot run it (FFmpeg version, encoder or hardware).</dd>
      <dt>White</dt><dd>Mean Y' error over the brightest areas, signed. Compression noise averages out, so this shows a
        white level (gain) error even when the max is dominated by noise. More than &plusmn;1.5 is shown in red.</dd>
      <dt>Max</dt><dd>The largest error of any pixel, in the worst plane, away from edges. 1 is rounding.</dd>
      <dt>Mean</dt><dd>The mean error, averaged over the planes, away from edges.</dd>
      <dt>p99</dt><dd>The 99th percentile error in the worst plane: 99% of pixels are at or below it. For lossy codecs,
        where Max is often one pixel set by compression, this shows whether the image as a whole is off.</dd>
      <dt>Max per plane</dt><dd>Max for each plane: Y'/Cb/Cr, or G/B/R for RGB encodes.</dd>
      <dt>Range tag</dt><dd>The stream's colour range tag: tv (limited) or pc (full).</dd>
      <dt>Source</dt><dd>For tests generated from the documentation (documentation_tests.yml): the page and line of the
        command.</dd>
    </dl>
    <p class="muted">Away from edges: more than 8 pixels from any step in the ideal image, so chroma subsampling filters and
      siting do not count.</p>
  </details>

  {%- set source_base = config.source_url | default("https://github.com/AcademySoftwareFoundation/EncodingGuidelines/blob/main/") %}
  {% for media_name, test in tests.items() %}
  {%- set ns = namespace(docs=false) %}
  {%- for r in test.results %}{% if doc_link(r, source_base) | trim %}{% set ns.docs = true %}{% endif %}{% endfor %}
  <h2>{{ media_name }}</h2>
  <div class="scroll">
  <table>
    <thead><tr>
      <th>Test</th><th title="pass, fail, known issue, unexpected pass or skipped">Result</th>
      <th title="Mean Y' error over the brightest areas (white level)">White</th>
      <th title="Largest error of any pixel, worst plane">Max</th>
      <th title="Mean error over all planes">Mean</th>
      <th title="99th percentile error, worst plane: less sensitive to single noisy pixels">p99</th>
      <th title="Max for each plane: Y'/Cb/Cr, or G/B/R">Max per plane</th><th title="Stream colour range tag">Range tag</th><th>pix_fmt</th>
      {%- if ns.docs %}<th class="left" title="Documentation page and line the command came from">Source</th>{% endif %}<th class="left">Arguments</th>
    </tr></thead>
    <tbody>
    {% for r in test.results %}
    {%- set to10 = 2.0 ** (10 - (r.bits or 10)) %}
    <tr>
      <td><a href="#{{ r.testbasename | e }}">{{ r.name | e }}</a></td>
      <td><span class="badge {{ status(r) }}">{{ status(r) }}</span></td>
      <td class="{{ 'bad' if r.white_error_10bit is number and r.white_error_10bit | abs > 1.5 }}">{{ num(r.white_error_10bit) }}</td>
      <td>{{ num(r.max_error_10bit, 1) }}</td>
      <td>{{ num(r.mean_error_10bit) }}</td>
      <td>{{ num(r.p99_error_10bit, 1) }}</td>
      <td title="{{ (r.plane_names or []) | join('/') }}">{% for n in (r.plane_names or []) %}{{ num(r['max_error_' ~ n] * to10, 1) if r['max_error_' ~ n] is number else '–' }}{{ ' / ' if not loop.last }}{% endfor %}</td>
      <td>{{ r.color_range | default('–') }}</td>
      <td>{{ r.pix_fmt | default('–') }}</td>
      {%- if ns.docs %}<td class="left">{{ doc_link(r, source_base) }}</td>{% endif %}
      <td class="left"><code>{{ r.encode_arguments | e }}</code></td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <div class="legend">
    Error maps, planes left to right (Y' | Cb | Cr, or G | B | R), 10-bit code values: <span>{{ "%+g" | format(-(test.results[0].error_map_limit or 4)) }}</span><span class="ramp"></span>
    <span>{{ "%+g" | format(test.results[0].error_map_limit or 4) }}</span> (too low / too high; dim: within rounding, one code value of the encode or one 10-bit code value for 12-bit and
    above; grey: edges, not compared; <a target="_blank" href="{{ guide }}#the-error-map">more</a>).
    Plots: mean error against level,
    <span class="swatch" style="background: var(--y)"></span> Y' / G
    <span class="swatch" style="background: var(--cb)"></span> Cb / B
    <span class="swatch" style="background: var(--cr)"></span> Cr / R.
  </div>

  {% for r in test.results %}
  <div class="card" id="{{ r.testbasename | e }}">
    <h3>{{ r.name | e }} <span class="badge {{ status(r) }}">{{ status(r) }}</span></h3>
    {%- if ns.docs %}<div class="note">From {{ doc_link(r, source_base) }}</div>{% endif %}
    <div class="note">{{ r.testresult | e }}
      &middot; <a target="_blank" href="{{ r.testbasename | e }}.log">encode log</a>
      &middot; <a target="_blank" href="{{ r.testbasename | e }}_tests.log">test log</a></div>
    {% if r.error_by_level %}
    <div class="row">
      {%- set plane_labels = {"y": "Y'", "cb": "Cb", "cr": "Cr", "g": "G", "b": "B", "r": "R"} %}
      <a target="_blank" href="{{ r.testbasename | e }}-errormap.png"
         {%- if r.source_image %} class="open-viewer" title="Click to compare with the decoded frame"
         data-name="{{ r.name | e }}" data-decoded="{{ r.testbasename | e }}.png" data-source="{{ r.source_image | e }}"
         data-planes="{% for n in r.plane_names %}{{ plane_labels[n] }}={{ r.testbasename | e }}-errormap-{{ n }}.png{{ ';' if not loop.last }}{% endfor %}"
         {%- endif %}><img class="map" loading="lazy"
         src="{{ r.testbasename | e }}-errormap.png" alt="Signed error of {{ (r.plane_names or []) | join(', ') }}, side by side"/></a>
      <div>
        {{ level_plot(r) }}
        <div class="muted">Mean error against level (10-bit)</div>
        <a target="_blank" href="{{ r.testbasename | e }}.png"><img class="thumb" loading="lazy" src="{{ r.testbasename | e }}.png" alt="Decoded frame"/></a>
      </div>
    </div>
    {% endif %}
    <details><summary>Command</summary><code>{{ r.command | e }}</code></details>
  </div>
  {% endfor %}
  {% endfor %}
  <dialog class="viewer" id="viewer">
    <div class="bar">
      <h3 id="viewer-name"></h3>
      <span class="muted">Left of the line</span><span class="group" id="viewer-base"></span>
      <span class="muted">Right</span><span class="group" id="viewer-plane"></span>
      <span class="muted">Zoom</span><span class="group" id="viewer-zoom"></span>
      <button class="close" id="viewer-close" title="Close (Esc)">&times;</button>
    </div>
    <div class="scroller"><div class="stage" id="viewer-stage">
      <img id="viewer-under" alt="Decoded frame" draggable="false"/><img class="over" id="viewer-over" alt="Error map" draggable="false"/><div class="divider" id="viewer-divider"></div>
    </div></div>
    <div class="labels"><span>Drag across the image to move the line. The error map is the same as the one on the page,
      for one plane; grey areas are left out of the comparison.</span><span id="viewer-pos"></span></div>
  </dialog>
  <script>
    (() => {
      const dialog = document.getElementById("viewer"), stage = document.getElementById("viewer-stage");
      const under = document.getElementById("viewer-under"), over = document.getElementById("viewer-over");
      const divider = document.getElementById("viewer-divider");
      let split = 50;
      function setSplit(percent) {
        split = Math.min(100, Math.max(0, percent));
        over.style.clipPath = `inset(0 0 0 ${split}%)`;
        divider.style.left = `${split}%`;
      }
      function buttons(holder, items, onPick) {
        holder.replaceChildren();
        items.forEach(([label, value], i) => {
          const b = document.createElement("button");
          b.textContent = label;
          b.setAttribute("aria-pressed", i === 0);
          b.addEventListener("click", () => {
            holder.querySelectorAll("button").forEach(x => x.setAttribute("aria-pressed", x === b));
            onPick(value);
          });
          holder.append(b);
        });
        if (items.length) onPick(items[0][1]);
      }
      function open(link) {
        document.getElementById("viewer-name").textContent = link.dataset.name;
        buttons(document.getElementById("viewer-base"),
                [["Decoded", link.dataset.decoded], ["Source", link.dataset.source]], url => under.src = url);
        buttons(document.getElementById("viewer-plane"),
                link.dataset.planes.split(";").map(p => p.split("=")), url => over.src = url);
        buttons(document.getElementById("viewer-zoom"), [["Fit", 0], ["1:1", 1], ["2x", 2], ["4x", 4]],
                zoom => stage.style.width = zoom ? `${(under.naturalWidth || 1920) * zoom / devicePixelRatio}px` : "100%");
        setSplit(50);
        dialog.showModal();
      }
      function drag(event) {
        const box = stage.getBoundingClientRect();
        setSplit((event.clientX - box.left) / box.width * 100);
        const x = Math.round((event.clientX - box.left) / box.width * (under.naturalWidth || 0));
        const y = Math.round((event.clientY - box.top) / box.height * (under.naturalHeight || 0));
        document.getElementById("viewer-pos").textContent = `x ${x}, y ${y}`;
      }
      // Stop the browser starting its own drag of the image.
      stage.addEventListener("dragstart", e => e.preventDefault());
      stage.addEventListener("pointerdown", e => { e.preventDefault(); stage.setPointerCapture(e.pointerId); drag(e); });
      stage.addEventListener("pointerup", e => stage.releasePointerCapture(e.pointerId));
      stage.addEventListener("pointermove", e => { if (stage.hasPointerCapture(e.pointerId)) drag(e); });
      document.getElementById("viewer-close").addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", e => { if (e.target === dialog) dialog.close(); });
      document.querySelectorAll("a.open-viewer").forEach(link => link.addEventListener("click", e => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;  // Still opens the image in a new tab.
        e.preventDefault();
        open(link);
      }));
    })();
  </script>
{% include "_analytics.html.jinja" %}
</body>
</html>
