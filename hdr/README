# Trying to test what HDR looks like in a browser, and what
# the tonemapping looks like - https://www.itu.int/dms_pub/itu-r/opb/rep/R-REP-BT.2390-12-2025-PDF-E.pdf



# Firstly we convert the test image, which should have a "Bad Image" in full rec2020 red, and a background which should be a rec709 red. I think the resulting image should be just red when tonemapped properly.

# The conversion and the colour tags are done by zscale + setparams rather than -x265-params, so they work on
# every FFmpeg version. -x265-params colorprim/transfer/colormatrix only tag the HEVC stream: they don't change
# the RGB to Y'CbCr conversion, so without -colorspace (or zscale) ffmpeg converts with BT.601 while the
# stream says BT.2020. See FFmpegChanges.md ("HDR and -x265-params"). master-display and max-cll still have to
# go through -x265-params.

ffmpeg -y -i hdr_test_chart_v3_pq.tif \
    -vf "zscale=rangein=full:matrix=2020_ncl:range=limited:filter=lanczos,setparams=color_primaries=bt2020:color_trc=smpte2084" \
    -c:v libx265 -crf 18 -pix_fmt yuv420p10le -x265-params " \
    master-display=G(8500,39850)B(6550,2300)R(35400,14600)WP(15635,16450)L(10000000,1): \
    max-cll=2000,50 " \
    -color_range tv -color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc \
    -movflags +faststart+write_colr -tag:v hvc1 output_hdr10.mp4

ffmpeg -y -i hdr_test_chart_v3_pq.tif \
    -vf "zscale=rangein=full:matrix=2020_ncl:range=limited:filter=lanczos,setparams=color_primaries=bt2020:color_trc=smpte2084" \
    -c:v libx265 -crf 18 -pix_fmt yuv420p10le -x265-params " \
    master-display=G(15000,30000)B(7500,3000)R(32000,16500)WP(15635,16450)L(1000000,1): \
    max-cll=100,50 " \
    -color_range tv -color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc \
    -movflags +faststart+write_colr -tag:v hvc1 output_hdr10_rec709.mp4

ffmpeg -y -i hdr_test_chart_v3_pq.tif \
    -vf "zscale=rangein=full:matrix=2020_ncl:range=limited:filter=lanczos,setparams=color_primaries=bt2020:color_trc=smpte2084" \
    -c:v libx265 -crf 18 -pix_fmt yuv420p10le -x265-params " \
    master-display=G(13250,34500)B(7500,3000)R(34000,16000)WP(15635,16450)L(10000000,1): \
    max-cll=2000,400 " \
    -color_range tv -color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc \
    -movflags +faststart+write_colr -tag:v hvc1 output_hdr10_p3.mp4

# Trying to tonemap with zscale
ffmpeg -y -i output_hdr10_rec709.mp4 -vf "zscale=t=linear:npl=100,tonemap=tonemap=hable:desat=0,zscale=p=bt709:t=bt709:m=bt709:r=tv,format=yuv420p10le" -color_primaries bt709 -color_trc bt709 -colorspace bt709 -c:v libx265 -crf 18 -preset medium -c:a copy -tag:v hvc1 output_srgb.mov

# Trying to tonemap with libplacebo, which needs vulkan
#ffmpeg -y -i output_hdr10_rec709.mp4 -vf "libplacebo=tonemapping=bt.2390:color_primaries=bt709:color_trc=bt709:colorspace=bt709" -color_primaries bt709 -color_trc bt709 -colorspace bt709 -c:v libx265 -crf 18 -preset medium -c:a copy output_srgb.mp4


# Rec.2020 primaries with a BT.709 transfer, same pattern as above.
ffmpeg -y -i gamut_test_chart_v2_rec2020.tif \
    -vf "zscale=rangein=full:matrix=2020_ncl:range=limited:filter=lanczos,setparams=color_primaries=bt2020:color_trc=bt709" \
    -c:v libx265 -crf 18 -pix_fmt yuv420p10le \
    -color_range tv -color_primaries bt2020 -color_trc bt709 -colorspace bt2020nc \
    -movflags +faststart+write_colr -tag:v hvc1 output_gamut.mp4
